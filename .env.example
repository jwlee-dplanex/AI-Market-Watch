# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=ai_market_watch
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Naver News API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# OpenDART API
OPENDART_API_KEY=

# Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SMART=claude-sonnet-5

# Slack
SLACK_WEBHOOK_URL=

# Voyage AI (임베딩)
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-multilingual-2
EMBEDDING_SIMILARITY_THRESHOLD=0.82

# Amazon Bedrock — Claude 모델 호출 (2026-09-14)
# 🔴 로컬에만 채운다. EC2에는 이 세 줄을 넣지 않는다 —
#    IAM Role(sandbox-jinwook-aimarketwatch-role)이 인스턴스 메타데이터로
#    임시 자격증명을 자동 발급하므로 키가 필요 없고, 서버에 장기 자격증명을
#    두지 않는 것이 IAM Role을 쓰는 이유다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2
# 1번(뉴스 정리) 판정 전용 모델 ID. "global." 접두사 필수 — 없으면 Bedrock이 거부한다.
BEDROCK_MODEL_FAST=global.anthropic.claude-haiku-4-5-20251001-v1:0
# 3~5번(주요 이슈, 주간 보고서, 월간 보고서) 생성 전용 모델 ID. 2026-09-15 실호출로 확인됐다.
# 서울 리전에서 AnthropicBedrock(Mantle 아님)으로 실제 응답을 받았다(services/llm.py 모듈독스트링
# 및 docs/planning.md "3~5단계를 LLM으로 옮기는 설계" 7-(c) 참고). Sonnet ID는
# "global.anthropic.claude-sonnet-5"이고 FAST와 달리 버전 접미사 "-v1:0"이 없다.
# Bedrock list_inference_profiles()로 실측한 그대로의 형태다.
#
# 🔴 2026-09-15 사용자 지시로 기본값을 다시 Haiku ID로 내렸다. 키는 그대로 두고 값만 바꿨다.
# ① Sonnet은 서울 리전에서 실제로 동작한다(위 실측). 안 되는 상태가 아니다.
# ② 그런데도 Haiku를 쓰는 이유는 비용이다(2026-09-15 사용자 지시 "무조건 비용을 아껴야 해").
# ③ 되돌리는 방법은 이 값 한 줄을 "global.anthropic.claude-sonnet-5"로 바꾸는 것뿐이다.
BEDROCK_MODEL_SMART=global.anthropic.claude-haiku-4-5-20251001-v1:0
